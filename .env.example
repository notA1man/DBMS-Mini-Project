# Copy to .env and fill in. Never commit .env.

# ---------- PostgreSQL ----------
POSTGRES_DB=skyops
POSTGRES_USER=skyops_owner
POSTGRES_PASSWORD=change_me_owner
# host port (change if 5432 is already taken, and update both URLs below)
POSTGRES_PORT=5432
# least-privilege role the app uses (created by db/postgres/init/01_roles.sh)
APP_DB_PASSWORD=change_me_app
DATABASE_URL=postgres://skyops_app:change_me_app@localhost:5432/skyops
# owner connection, used only for migrations/seeding
DATABASE_URL_OWNER=postgres://skyops_owner:change_me_owner@localhost:5432/skyops

# ---------- MongoDB ----------
MONGO_ROOT_USER=skyops
MONGO_ROOT_PASSWORD=change_me_mongo
# host port (change if 27017 is already taken, and update MONGODB_URI)
MONGO_PORT=27017
MONGODB_URI=mongodb://skyops:change_me_mongo@localhost:27017/?authSource=admin&replicaSet=rs0&directConnection=true
MONGODB_DB=skyops

# ---------- Neo4j ----------
NEO4J_PASSWORD=change_me_neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# set false on AuraDB Free (no Graph Data Science plugin)
NEO4J_GDS_ENABLED=true

# ---------- Auth ----------
# generate with: npx auth secret
AUTH_SECRET=
# needed for `next start` outside Vercel (Auth.js otherwise rejects localhost as an untrusted host)
# AUTH_TRUST_HOST=true
# Enable only when a trusted proxy overwrites x-forwarded-for; otherwise budgets are shared.
AUTH_TRUST_PROXY=false
# key used by pgcrypto to encrypt passport numbers
PII_ENCRYPTION_KEY=

# ---------- AI (local, free) ----------
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDINGS_ENABLED=true
# Optional: EMBEDDING_CACHE_DIR=.models
# Optional owner-only bootstrap (no default admin password):
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# optional, only when the `ai` compose profile is running
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---------- Operations (Aditya) ----------
# Bearer token for GET /api/cron/outbox (vercel.json runs it daily; Vercel sends it automatically)
CRON_SECRET=
# Optional: npm run db:seed:ops creates ops@ / captain@ / purser@skyops.test with this password (12-72 bytes)
# SEED_STAFF_PASSWORD=
# Optional: npm run db:seed:demo needs a 12-72 byte demo-only password
# SEED_DEMO_PASSWORD=
# Optional: share of seats npm run db:seed:traffic fills (default 0.35)
# DEMO_LOAD=0.35
# Optional: reuse an installed Chromium for the browser tests instead of `npx playwright install`
# PLAYWRIGHT_CHROMIUM=/path/to/chrome
