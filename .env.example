# Copy to .env and fill in. Never commit .env.

# ---------- PostgreSQL ----------
POSTGRES_DB=skyops
POSTGRES_USER=skyops_owner
POSTGRES_PASSWORD=change_me_owner
# least-privilege role the app uses (created by db/postgres/init/01_roles.sh)
APP_DB_PASSWORD=change_me_app
DATABASE_URL=postgres://skyops_app:change_me_app@localhost:5432/skyops
# owner connection, used only for migrations/seeding
DATABASE_URL_OWNER=postgres://skyops_owner:change_me_owner@localhost:5432/skyops

# ---------- MongoDB ----------
MONGO_ROOT_USER=skyops
MONGO_ROOT_PASSWORD=change_me_mongo
MONGODB_URI=mongodb://skyops:change_me_mongo@localhost:27017/?authSource=admin&replicaSet=rs0&directConnection=true
MONGODB_DB=skyops

# ---------- Neo4j ----------
NEO4J_PASSWORD=change_me_neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# set false on AuraDB Free (no Graph Data Science plugin)
NEO4J_GDS_ENABLED=true

# ---------- Auth ----------
# generate with: npx auth secret
AUTH_SECRET=
# key used by pgcrypto to encrypt passport numbers
PII_ENCRYPTION_KEY=

# ---------- AI (local, free) ----------
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# optional, only when the `ai` compose profile is running
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
