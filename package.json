    "db:mongo:ops": "tsx scripts/mongo-ops.ts",
    "outbox:drain": "tsx scripts/outbox-worker.ts --drain",
    "worker": "tsx scripts/outbox-worker.ts",
    "graph:reconcile": "tsx scripts/graph-reconcile.ts",
    "db:seed:traffic": "tsx scripts/seed-demo-traffic.ts",
    "bench:indexes": "tsx scripts/bench-indexes.ts",
